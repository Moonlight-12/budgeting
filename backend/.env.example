# Primary MongoDB cluster
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/budgeting

# Secondary MongoDB cluster (real-time failover replica)
MONGODB_URI_SECONDARY=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/budgeting

# Weekly backup MongoDB cluster (separate project)
MONGODB_URI_BACKUP=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/

# Auth
JWT_SECRET=<random 64-char string>
REFRESH_SECRET=<random 64-char string>

# Server
PORT=5001
FRONTEND_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=<your Google OAuth client ID>

# SMTP (for OTP emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<your Gmail address>
SMTP_PASS=<Gmail app password>
SMTP_FROM=<your Gmail address>

# Encryption key for sensitive fields — must be a 64-char hex string (32 bytes)
ENCRYPTION_KEY=<random 64-char hex string>
